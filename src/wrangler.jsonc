{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtd-mining-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtd-mining-db",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
